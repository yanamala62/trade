# ==============================================================================
# AI Trade Assist - Backend Standalone Environment Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=trade_assist_secret_key_change_in_production
CORS_ORIGINS=["*"]

# Database Configuration (SQLite default for simple standalone setup)
DATABASE_URL=sqlite+aiosqlite:///./ai_trade_assist.db
# Or PostgreSQL/TimescaleDB:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/tradeassist

# Redis Configuration (Optional for caching and pub/sub)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# BROKER APIS (100% FREE LIVE NSE MARKET FEEDS)
# ==============================================================================
# Select active broker: REAL_NSE_PUBLIC | ANGEL_ONE | FYERS | MOCK
ACTIVE_BROKER=REAL_NSE_PUBLIC

# --- Optional: Angel One SmartAPI (Free) ---
# Sign up & get API key at: https://smartapi.angelbroking.com/
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_KEY=

# --- Optional: Fyers API v3 (Free Secondary Feed) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

# Feed Quality & Safety
FEED_DIVERGENCE_THRESHOLD_PCT=0.25
STALE_DATA_TIMEOUT_SECONDS=5.0

# LLM Configuration (Google Gemini API - Free Tier)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
