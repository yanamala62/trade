# ==============================================================================
# AI Trade Assist - Environment Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_me_to_a_secure_random_key_for_jwt_and_sessions
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (SQLite default for simple local setup; or PostgreSQL/TimescaleDB)
DATABASE_URL=sqlite+aiosqlite:///./ai_trade_assist.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradeassist

# Redis Configuration (For live tick pub/sub and high-speed cache)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# BROKER APIS (100% FREE LIVE NSE MARKET FEEDS)
# ==============================================================================
# Select active broker: ANGEL_ONE | FYERS | REAL_NSE_PUBLIC
ACTIVE_BROKER=ANGEL_ONE

# --- Primary Feed: Angel One SmartAPI (Free) ---
# Sign up & get API key at: https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_angel_client_code_here
ANGEL_PIN=your_4_digit_mpin_here
# Base32 TOTP secret from authenticator setup (used by pyotp for automated login):
ANGEL_TOTP_KEY=your_base32_totp_secret_here

# --- Secondary Feed: Fyers API v3 (Free Cross-Check Feed) ---
# Sign up at: https://myapi.fyers.in/
FYERS_APP_ID=your_fyers_app_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_ACCESS_TOKEN=your_fyers_daily_access_token_here

# Max allowed tick divergence between primary and secondary feed (in percentage)
FEED_DIVERGENCE_THRESHOLD_PCT=0.25
# Stale data timeout in seconds (signals blocked if no ticks received within this window)
STALE_DATA_TIMEOUT_SECONDS=3.0

# ==============================================================================
# LLM CONFIGURATION (FREE TIER GOOGLE GEMINI)
# ==============================================================================
# Get free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# ALERTS & NOTIFICATIONS
# ==============================================================================
# Telegram Bot Alerts (Create bot via @BotFather and get chat ID via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# RISK GATE & TRADING DEFAULTS
# ==============================================================================
CAPITAL=500000.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=5
MIN_REWARD_TO_RISK=1.5
SQUARE_OFF_TIME_IST=15:15
NO_TRADE_OPEN_MINUTES=5
NO_TRADE_CLOSE_MINUTES=15
