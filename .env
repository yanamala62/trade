# ==============================================================================
# AI Trade Assist - Environment Configuration
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_8941279412
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SQLite async local storage
DATABASE_URL=sqlite+aiosqlite:///d:/ReactJs_2022_Shudhakar_sharma/proj/trading_app/ai_trade_assist.db
# Redis connection (falls back to memory channel if Redis is not running)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# BROKER APIS
# Options: ANGEL_ONE | FYERS | REAL_NSE_PUBLIC
# ==============================================================================
ACTIVE_BROKER=REAL_NSE_PUBLIC

# Primary Feed: Angel One SmartAPI (Free)
# https://smartapi.angelbroking.com/
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_KEY=

# Secondary Feed: Fyers API v3 (Free)
# https://myapi.fyers.in/
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

FEED_DIVERGENCE_THRESHOLD_PCT=0.25
STALE_DATA_TIMEOUT_SECONDS=5.0

# ==============================================================================
# LLM CONFIGURATION (FREE TIER GOOGLE GEMINI)
# ==============================================================================
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# ALERTS & NOTIFICATIONS (TELEGRAM)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# RISK GATE & TRADING DEFAULTS
# ==============================================================================
CAPITAL=500000.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=5
MIN_REWARD_TO_RISK=1.5
SQUARE_OFF_TIME_IST=15:15
NO_TRADE_OPEN_MINUTES=5
NO_TRADE_CLOSE_MINUTES=15
